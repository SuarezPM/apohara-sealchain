# Rust build artifacts
target/
**/*.rs.bk

# OS noise
.DS_Store
*.swp

# Local keystore — private key material must never be committed
**/apohara-sealchain/*.pem
**/apohara-sealchain/hmac.key

# Python (vector generator) caches
__pycache__/
*.pyc

# In-browser verifier: wasm-pack output is generated, not committed. It is built
# from crates/sealchain-wasm by .github/workflows/pages.yml and served from
# GitHub Pages (keeps the compiled .wasm out of source — Scorecard
# Binary-Artifacts). Build locally with the command in web/README.md.
web/pkg/
